# Fernet key untuk encrypt credential (llm_providers.api_key,
# github_connections.access_token). Dibuat otomatis oleh backend/auth.py kalau
# FERNET_KEY tidak disetel di env. Isinya setara password - membocorkanya
# membuat semua credential tersimpan bisa didekripsi siapa saja.
backend/.fernet_key

# Scratch file debugging lokal - jangan pernah ikut commit
backend/test_bugfix.py
backend/test_debug.py
backend/test_debug2.py

.DS_Store
Thumbs.db

workspace/

projects_registry.json
backend/projects_registry.json

# Log output dari `npm run dev` yang di-redIRECT ke file saat menjalankan
# server secara background (npm tidak bisa menulis ke stdout dan stderr ke
# satu file sekaligus, jadi perintahnya dibungkus cmd /c). Log ini berubah
# setiap kali modul di-recompile, dan isinya bisa memuat path absolut mesin
# lokal - tidak ada gunanya di repo dan tidak boleh ikut ter-commit.
frontend-dev.log
backend-dev.log
*.dev.log

# ---------------------------------------------------------------------------
# CALIBER Case 1 - dataset dan hasil indeks
# ---------------------------------------------------------------------------
# Dataset CALIBER ("Case 1_ Manufacturing Knowledge Hub") TIDAK BOLEH ikut
# commit. Lisensinya milik panitia dan hanya boleh dipakai untuk submission
# final ini. Yang di-commit sebagai gantinya adalah fetch_dataset.py, yang
# memberi tahu reviewer cara mendapatkannya, dan seluruh hasil ekstraksi
# metadata yang bisa direproduksi ulang dari dataset aslinya.
backend/dataset/
backend/plant/trusthub_plant.db
backend/plant/trusthub_plant.db-journal
backend/plant/trusthub_plant.db-wal
backend/plant/trusthub_plant.db-shm
# Log evaluasi yang berisi potongan isi dokumen (berkas bisa besar dan
# berasal dari dataset yang tidak boleh disalin)
backend/plant/evaluation_results.json

# Screenshot per-slide hasil render deck. Artefak build: bisa dibuat ulang
# dengan `node docs/deck/build/render.mjs`, dan 1,1 MB untuk 15 PNG tidak
# layak disimpan di git. PDF-nya sendiri ikut di-commit karena itu deliverable.
docs/deck/shots/

# Frame video demo, polos dan|captioned. Artefak build, ~3 MB, bisa dibuat
# ulang dengan `npm run capture && npm run caption` di docs/demo/build.
# Yang ikut di-commit: beats.json (teks yang benar-benar ter-render per frame,
# bahan bukti verify.py) dan TrustHUB-demo.mp4 (deliverable).
docs/demo/frames/
docs/demo/captioned/

# Audio narasi demo, 3,7 MB untuk 14 WAV. Artefak build: dibuat ulang dengan
# `powershell -ExecutionPolicy Bypass -File docs/demo/vo/build_vo.ps1`, tanpa
# jaringan. Yang ikut commit: script.json (teks narasi, bahan review) dan MP4
# TrustHUB-demo-vo.mp4 yang sudah jadi deliverable.
docs/demo/vo/wav/

# Salinan media untuk Remotion. Remotion hanya menyajikan berkas dari public/,
# jadi isinya harus ada di sana saat render, tapi salinan kedua dari MP4 dan WAV
# yang sama tidak perlu disimpan. Dibuat oleh `npm run assets` di
# docs/demo/remotion.
docs/demo/remotion/public/

# Local test screenshots
frontend/.screenshots/
frontend/capture_screenshots.mjs
