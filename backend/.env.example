# =============================================================================
# TrustHub Backend - Environment Variables
# =============================================================================
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#   cp .env.example .env
#
# JANGAN commit file `.env` yang berisi token/rahasia ke Git.
# =============================================================================

# ---------------------------------------------------------------------------
# TRUSTHUB_API_TOKEN  (WAJIB untuk production)
# ---------------------------------------------------------------------------
# Token autentikasi untuk mengakses seluruh endpoint non-publik.
# Nilai ini harus SAMA PERSIS dengan TRUSTHUB_API_TOKEN di frontend/.env.local,
# karena route handler proxy menyuntikkannya ke setiap request ke backend.
#
# Kalau kosong, backend membuat token acak per-proses lalu mencetaknya ke log.
# Akibatnya setiap restart menghasilkan token baru, jadi proxy yang masih
# memegang token lama akan dibalas 502 "Token API backend ditolak".
#
# Generate token kuat:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Contoh:
#   TRUSTHUB_API_TOKEN=b-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRUSTHUB_API_TOKEN=

# ---------------------------------------------------------------------------
# TRUSTHUB_ALLOWED_ORIGINS  (opsional - CORS dynamic port)
# ---------------------------------------------------------------------------
# Daftar origin (comma-separated) yang diizinkan oleh CORS middleware.
# Default: http://localhost:3000, http://127.0.0.1:3000,
#          http://localhost:3001, http://127.0.0.1:3001
#
# Jika frontend berjalan di port lain (misalnya 3002), tambahkan di sini.
# Wildcard (*) TIDAK diizinkan - akan diabaikan dan fallback ke default.
#
# Contoh:
#   TRUSTHUB_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
TRUSTHUB_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# FERNET_KEY  (opsional - enkripsi credential)
# ---------------------------------------------------------------------------
# Kunci 32-byte (url-safe base64, 44 karakter) untuk mengenkripsi credential
# yang disimpan di database: llm_providers.api_key dan
# github_connections.access_token.
#
# Kalau variabel ini dikosongkan, backend membangkitkan kunci sekali lalu
# menyimpannya ke backend/.fernet_key (sudah masuk .gitignore) dan memakainya
# lagi di restart berikutnya. Jadi credential TIDAK hilang saat restart.
#
# Tetapkan variabel ini kalau:
#   - backend dijalankan sebagai lebih dari satu proses/container, karena
#     file .fernet_key tidak dibagi antar mesin; atau
#   - Anda ingin kunci bisa dirotasi secara eksplisit.
#
# CATATAN: mengganti FERNET_KEY membuat SEMUA credential yang tersimpan tidak
# bisa didekripsi lagi, dan tidak ada cara memulihkannya selain mengetik ulang
# API key-nya. Jangan ganti nilainya kecuali memang sedang merotasi.
#
# File .fernet_key yang rusak atau kosong TIDAK diam-diam diganti. Backend
# berhenti dengan pesan yang menyebut file dan cara memperbaikinya, karena
# diam-diam membangkitkan kunci baru sama saja menghapus semua credential -
# persis bug yang diperbaiki dengan menyimpan kunci, bukan mengacaknya.
#
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---------------------------------------------------------------------------
# TRUSTHUB_PUBLIC_PATHS  (opsional - path publik tambahan)
# ---------------------------------------------------------------------------
# Path tambahan yang bisa diakses tanpa token, comma-separated.
# Default publik: /health, /docs, /redoc, /openapi.json, /docs/oauth2-redirect
#
# Contoh:
#   TRUSTHUB_PUBLIC_PATHS=/custom-health,/status
TRUSTHUB_PUBLIC_PATHS=
